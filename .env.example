# ══════════════════════════════════════════════════════════════
#  연금 Agent 환경 변수 — 이 파일을 .env 로 복사해서 값을 채우세요
#     cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── ★★★ 여기에 CLOVA Studio API 키를 넣으세요 ★★★ ─────────────
# 현재 개발 컨테이너에서는 clovastudio.stream.ntruss.com 접속이
# 네트워크 정책으로 차단돼 있어 실제 호출을 검증하지 못했습니다.
# 키를 넣고 아래 명령으로 스모크 테스트를 먼저 돌려 주세요.
#     python -m app.llm.smoke_test
CLOVA_API_KEY=
# 테스트 앱 요청 ID (CLOVA Studio 콘솔에서 발급). 없으면 비워둬도 동작합니다.
CLOVA_REQUEST_ID=

# 엔드포인트 — 콘솔에서 발급받은 모델 경로로 교체하세요.
CLOVA_ENDPOINT=https://clovastudio.stream.ntruss.com/testapp/v1/chat-completions/HCX-005

# LLM 모드: auto | real | mock
#   auto : 키가 있으면 실제 호출, 없으면 mock (기본값)
#   real : 항상 실제 호출 (키 없으면 기동 시 에러)
#   mock : 항상 mock — 네트워크·크레딧 소모 없이 파이프라인 전체 점검용
LLM_MODE=auto

# 단계별 타임아웃(초). Phase 1 스모크 테스트로 실지연을 측정한 뒤 재배분하세요.
CLOVA_TIMEOUT_SEC=8
CLOVA_MAX_RETRY=1

# ── 검색 백엔드 ────────────────────────────────────────────────
# 기본은 파일 기반 인덱스(외부 DB 불필요). PostgreSQL을 쓰려면 URL을 채우세요.
DATABASE_URL=
INDEX_PATH=data/index

# ── 임베딩 사용 여부 (대회 제약 1 미확인 사항) ─────────────────
# 임베딩 모델이 "LLM은 HyperCLOVA X만" 제약에 걸리는지 확인되지 않아
# 기본값은 false(BM25 단독)입니다. 허용이 확인되면 true로만 바꾸면
# app/retrieval/hybrid.py 의 임베딩 경로가 활성화됩니다.
USE_EMBEDDING=false
