# ══════════════════════════════════════════════════════════════
#  연금 Agent 환경 변수 — 이 파일을 .env 로 복사해서 값을 채우세요
#     cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── ★★★ 여기에 CLOVA Studio API 키를 넣으세요 ★★★ ─────────────
# CLOVA Studio 실연동 확인 완료(2026-08-18) — L1·L5'·L6 세 호출 지점
# 전부 실제 HyperCLOVA X 응답을 받는 것을 배포 환경에서 확인했습니다.
# 키를 넣고 아래 명령으로 스모크 테스트를 먼저 돌려 주세요.
#     python -m app.llm.smoke_test
# 키 형식이 두 가지입니다. 코드가 접두사를 보고 인증 방식을 자동으로 맞춥니다.
#   · 'nv-'로 시작 → 신형(Bearer) 인증, 아래 v3 엔드포인트와 짝을 이룹니다.
#   · 그 외(예: 'ncp'류 접두)  → 구형 콘솔 키. Bearer가 아니라
#     X-NCP-CLOVASTUDIO-API-KEY 헤더로 인증하며, **v3 엔드포인트에서는
#     쓸 수 없습니다.** CLOVA_ENDPOINT를 그 테스트앱/서비스앱의 실제 호출
#     URL(.../testapp/v1/chat-completions/<앱ID> 또는
#     .../serviceapp/v1/chat-completions/<앱ID> — 콘솔의 "요청 URL"을
#     그대로 복사)로 바꿔야 합니다. 이 형식으로 v3 URL을 두면 기동 시
#     바로 에러가 나서 알려줍니다(401을 받고 나서야 알게 되는 것을 방지).
CLOVA_API_KEY=
# 구형 콘솔 키를 쓸 때, 콘솔에 API Key와 별도로 "API Gateway Key"가
# 함께 발급돼 있다면 여기에 넣으세요. 신형(nv-) 키에는 필요 없습니다.
CLOVA_APIGW_KEY=
# 테스트 앱 요청 ID (CLOVA Studio 콘솔에서 발급). 없으면 비워둬도 동작합니다.
CLOVA_REQUEST_ID=

# 엔드포인트 — 신형(nv-) 키를 쓴다면 아래 v3 기본값을 그대로 두면 됩니다.
#   v3 : https://clovastudio.stream.ntruss.com/v3/chat-completions/HCX-005
#   v1(구형 키 전용) : 콘솔에서 발급받은 테스트앱/서비스앱의 실제 URL
#                       (예: https://clovastudio.stream.ntruss.com/testapp/v1/chat-completions/<앱ID>)
# 두 경로는 요청 파라미터 이름도 다릅니다(repetitionPenalty vs repeatPenalty 등).
# 코드가 URL에 '/v3/'가 있는지 보고 자동으로 맞춥니다 — 경로만 바꾸면 됩니다.
# 경량 모델을 쓰려면 모델명만 교체하세요 (예: HCX-DASH-002).
CLOVA_ENDPOINT=https://clovastudio.stream.ntruss.com/v3/chat-completions/HCX-005

# LLM 모드: auto | real | mock
#   auto : 키가 있으면 실제 호출, 없으면 mock (기본값)
#   real : 항상 실제 호출 (키 없으면 기동 시 에러)
#   mock : 항상 mock — 네트워크·크레딧 소모 없이 파이프라인 전체 점검용
LLM_MODE=auto

# 단계별 타임아웃(초). smoke_test는 짧은 프로브 문장이라 1초 내로 끝나지만,
# 실제 근거 문서가 실린 프롬프트(L5'/L6, 입력 3000토큰 안팎)는 5~8초가
# 정상 범위다. 너무 낮게 두면 정상 호출도 타임아웃→재시도로 튕겨 전체
# 처리 시간만 늘어난다(재시도도 똑같이 오래 걸리기 때문).
CLOVA_TIMEOUT_SEC=15
CLOVA_MAX_RETRY=1

# ── 검색 백엔드 ────────────────────────────────────────────────
# 기본은 파일 기반 인덱스(외부 DB 불필요). PostgreSQL을 쓰려면 URL을 채우세요.
DATABASE_URL=
INDEX_PATH=data/index

# ── 임베딩 (타사 모델 사용 허용 확인 완료 · 2026-08-19) ────────
# 임베딩은 검색 순위용 벡터일 뿐 답변 문장을 만들지 않으므로 대회 제약 밖입니다.
# ⚠️ 답변을 만드는 L1·L5'·L6 세 호출만은 HyperCLOVA X 전용입니다 (실격 사유).
#
# 켜기 전에 반드시 청크 벡터를 먼저 만들어야 합니다:
#     python -m app.ingest.build_embeddings
# 벡터 없이 true로 두면 자동으로 BM25 단독으로 돕니다(에러 아님).
USE_EMBEDDING=true

# 백엔드: local(기본) | clova
#   local — 로컬 모델. 호출 제한 없음, 배치로 몇 분이면 끝. API 키 불필요.
#           pip install -r requirements-embedding.txt 가 필요합니다.
#   clova — CLOVA Studio API. 건당 1회 호출 + 속도 제한(429)이라
#           8천 청크에 2시간 넘게 걸리고 자주 끊깁니다. 권장하지 않습니다.
EMBEDDING_BACKEND=local

# local 백엔드가 쓸 모델 (첫 실행 때 자동 다운로드)
#   intfloat/multilingual-e5-small  ~470MB  기본값, 한국어 양호
#   intfloat/multilingual-e5-base   ~1.1GB
#   BAAI/bge-m3                     ~2.2GB  최고 품질 (디스크 여유 필요)
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# clova 백엔드를 쓸 때만 필요
CLOVA_EMBEDDING_ENDPOINT=https://clovastudio.stream.ntruss.com/v1/api-tools/embedding/v2

# BM25 순위와 벡터 순위를 RRF로 합칠 때 벡터 쪽 가중치(0~1).
EMBEDDING_WEIGHT=0.5

# ── 파이프라인 예산 · 재인덱싱 ──────────────────────────────────
# docker-compose.yml이 이 두 값을 ${VAR:-기본값} 형태로 읽습니다
# (compose는 이 파일과 같은 위치의 .env를 변수 치환에도 자동으로 씁니다).

# 요청 하나에 쓸 수 있는 전체 시간(초). 각 LLM 단계는 남은 예산이
# 모자라면 결정론적 경로로 생략됩니다(멈추지 않고 축퇴합니다).
# ⚠️ 평가 측 타임아웃과의 트레이드오프라 코드가 혼자 정할 수 없는 값입니다.
#    10초 미만은 거부됩니다(모든 LLM 단계가 생략된 200 OK는 절대 제약
#    #1 위반). 운영자 확인 상한이 60초라면 55(여유 4초)를 권장합니다.
PIPELINE_BUDGET_SEC=55

# true로 두고 기동하면 인덱스를 무조건 다시 만듭니다(코퍼스나 추출
# 로직이 바뀐 뒤 1회만 켜고 다시 false로 되돌리는 식으로 씁니다).
# 인덱스는 호스트 볼륨(./data/index)에 남아 재사용되므로, 이 값 없이는
# 이미지를 새로 빌드해도 예전 인덱스가 그대로 남습니다.
FORCE_REINDEX=false
