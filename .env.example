# ══════════════════════════════════════════════════════════════
#  연금 Agent 환경 변수 — 이 파일을 .env 로 복사해서 값을 채우세요
#     cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── ★★★ 여기에 CLOVA Studio API 키를 넣으세요 ★★★ ─────────────
# 현재 개발 컨테이너에서는 clovastudio.stream.ntruss.com 접속이
# 네트워크 정책으로 차단돼 있어 실제 호출을 검증하지 못했습니다.
# 키를 넣고 아래 명령으로 스모크 테스트를 먼저 돌려 주세요.
#     python -m app.llm.smoke_test
CLOVA_API_KEY=
# 키 형식이 두 가지입니다. 코드가 접두사를 보고 인증 방식을 자동으로 맞춥니다.
#   · 'nv-'로 시작 → 신형(Bearer) 인증, 아래 v3 엔드포인트와 짝을 이룹니다.
#   · 그 외(예: 'ncp'류 접두)  → 구형 콘솔 키. Bearer가 아니라
#     X-NCP-CLOVASTUDIO-API-KEY 헤더로 인증하며, **v3 엔드포인트에서는
#     쓸 수 없습니다.** CLOVA_ENDPOINT를 그 테스트앱/서비스앱의 실제 호출
#     URL(.../testapp/v1/chat-completions/<앱ID> 또는
#     .../serviceapp/v1/chat-completions/<앱ID> — 콘솔의 "요청 URL"을
#     그대로 복사)로 바꿔야 합니다. 이 형식으로 v3 URL을 두면 기동 시
#     바로 에러가 나서 알려줍니다(401을 받고 나서야 알게 되는 것을 방지).
CLOVA_API_KEY=
# 구형 콘솔 키를 쓸 때, 콘솔에 API Key와 별도로 "API Gateway Key"가
# 함께 발급돼 있다면 여기에 넣으세요. 신형(nv-) 키에는 필요 없습니다.
CLOVA_APIGW_KEY=
# 테스트 앱 요청 ID (CLOVA Studio 콘솔에서 발급). 없으면 비워둬도 동작합니다.
CLOVA_REQUEST_ID=

# 엔드포인트 — 신형(nv-) 키를 쓴다면 아래 v3 기본값을 그대로 두면 됩니다.
#   v3 : https://clovastudio.stream.ntruss.com/v3/chat-completions/HCX-005
#   v1(구형 키 전용) : 콘솔에서 발급받은 테스트앱/서비스앱의 실제 URL
#                       (예: https://clovastudio.stream.ntruss.com/testapp/v1/chat-completions/<앱ID>)
# 두 경로는 요청 파라미터 이름도 다릅니다(repetitionPenalty vs repeatPenalty 등).
# 코드가 URL에 '/v3/'가 있는지 보고 자동으로 맞춥니다 — 경로만 바꾸면 됩니다.
# 경량 모델을 쓰려면 모델명만 교체하세요 (예: HCX-DASH-002).
CLOVA_ENDPOINT=https://clovastudio.stream.ntruss.com/v3/chat-completions/HCX-005

# LLM 모드: auto | real | mock
#   auto : 키가 있으면 실제 호출, 없으면 mock (기본값)
#   real : 항상 실제 호출 (키 없으면 기동 시 에러)
#   mock : 항상 mock — 네트워크·크레딧 소모 없이 파이프라인 전체 점검용
LLM_MODE=auto

# 단계별 타임아웃(초). smoke_test는 짧은 프로브 문장이라 1초 내로 끝나지만,
# 실제 근거 문서가 실린 프롬프트(L5'/L6, 입력 3000토큰 안팎)는 5~8초가
# 정상 범위다. 너무 낮게 두면 정상 호출도 타임아웃→재시도로 튕겨 전체
# 처리 시간만 늘어난다(재시도도 똑같이 오래 걸리기 때문).
CLOVA_TIMEOUT_SEC=15
CLOVA_MAX_RETRY=1

# ── 검색 백엔드 ────────────────────────────────────────────────
# 기본은 파일 기반 인덱스(외부 DB 불필요). PostgreSQL을 쓰려면 URL을 채우세요.
DATABASE_URL=
INDEX_PATH=data/index

# ── 임베딩 사용 여부 (대회 제약 1 미확인 사항) ─────────────────
# 임베딩 모델이 "LLM은 HyperCLOVA X만" 제약에 걸리는지 확인되지 않아
# 기본값은 false(BM25 단독)입니다. 허용이 확인되면 true로만 바꾸면
# app/retrieval/hybrid.py 의 임베딩 경로가 활성화됩니다.
USE_EMBEDDING=false
