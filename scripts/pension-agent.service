# NCP 서버 상시 구동용 systemd 유닛
#   sudo cp scripts/pension-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pension-agent
#
# 경로가 다르면 WorkingDirectory / ExecStart 를 고치십시오.
[Unit]
Description=Pension Agent (MIRAE ASSET AI Festival)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Pension-Agent
# 키는 이 파일에서만 읽는다 — 유닛 파일에 직접 쓰지 말 것
EnvironmentFile=/root/Pension-Agent/.env
ExecStart=/root/Pension-Agent/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
# 평가 기간 무중단 운영을 위해 실패해도 계속 재시작
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
